<UserControl x:Class="ClipIt.OverlayCornerPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Width="40" Height="40" VerticalAlignment="Center">
  <UserControl.Resources>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#8095B0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Target" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="3">
              <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" StrokeLineJoin="Round"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Target" Property="Background" Value="#233956"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Target" Property="BorderBrush" Value="#9FC6FF"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#72AAFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid KeyboardNavigation.DirectionalNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <RadioButton x:Name="TopLeft" ToolTip="Top left" AutomationProperties.Name="Top left">
      <RadioButton.Tag><PathGeometry Figures="M 0 9 V 0 H 9"/></RadioButton.Tag>
    </RadioButton>
    <RadioButton x:Name="TopRight" Grid.Column="1" ToolTip="Top right" AutomationProperties.Name="Top right">
      <RadioButton.Tag><PathGeometry Figures="M 0 0 H 9 V 9"/></RadioButton.Tag>
    </RadioButton>
    <RadioButton x:Name="BottomLeft" Grid.Row="1" ToolTip="Bottom left" AutomationProperties.Name="Bottom left">
      <RadioButton.Tag><PathGeometry Figures="M 0 0 V 9 H 9"/></RadioButton.Tag>
    </RadioButton>
    <RadioButton x:Name="BottomRight" Grid.Row="1" Grid.Column="1" IsChecked="True" ToolTip="Bottom right" AutomationProperties.Name="Bottom right">
      <RadioButton.Tag><PathGeometry Figures="M 0 9 H 9 V 0"/></RadioButton.Tag>
    </RadioButton>
  </Grid>
</UserControl>

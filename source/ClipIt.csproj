<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ClipIt</AssemblyName>
    <Version>0.5.1</Version>
    <Product>ClipIt</Product>
    <Description>Instant replay, always within reach.</Description>
    <ApplicationIcon>Assets\ClipIt.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="Assets\ClipIt-logo.png" />
    <Resource Include="Assets\ClipIt.ico" />
  </ItemGroup>
</Project>

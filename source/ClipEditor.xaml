<UserControl x:Class="ClipIt.ClipEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipIt" PreviewKeyDown="Editor_KeyDown">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="EditorHeader" Height="60" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="36" Height="36" VerticalAlignment="Center" Style="{StaticResource Quiet}" Click="Back_Click" Padding="8" Margin="0,0,12,0" ToolTip="Back" AutomationProperties.Name="Back"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
        <DockPanel x:Name="NameDisplay" HorizontalAlignment="Left"><Button x:Name="RenameButton" DockPanel.Dock="Right" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Style="{StaticResource Quiet}" Padding="7" Click="Rename_Click" AutomationProperties.Name="Rename clip" ToolTip="Rename clip"/><TextBlock x:Name="ClipTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
        <TextBox x:Name="NameEdit" Visibility="Collapsed" KeyDown="Name_KeyDown" LostKeyboardFocus="Name_Blurred" AutomationProperties.Name="Clip name"/>
        <TextBlock x:Name="ClipDetails" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
      </StackPanel>
      <Grid x:Name="HeaderStatus" Grid.Column="2" Height="52" Margin="8,0,16,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="EditorMessage" Text="" Foreground="#A1B8D6" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="8,0,0,0" Padding="8,5" VerticalAlignment="Center"/>
        <Grid x:Name="RenderProgress" Grid.ColumnSpan="2" Visibility="Collapsed" Height="3" VerticalAlignment="Bottom"><ProgressBar Height="3" IsIndeterminate="True" Foreground="#4D8DFF" Background="#22344C" BorderThickness="0"/></Grid>
      </Grid>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FavoriteButton" ToolTip="Mark as Favorite" AutomationProperties.Name="Mark as Favorite" Click="Favorite_Click" Padding="12,9" Margin="0,0,8,0"><Path x:Name="FavoriteIcon" Width="16" Height="16" Stretch="Uniform" Stroke="#A9BDD9" StrokeThickness="1.35" StrokeLineJoin="Round" Data="M 8,1 L 10.2,5.5 15.2,6.2 11.6,9.7 12.4,14.7 8,12.3 3.6,14.7 4.4,9.7 0.8,6.2 5.8,5.5 Z"/></Button>
        <Button x:Name="ExplorerButton" Content="Open in Explorer" Click="Explorer_Click" Padding="12,9"/>
        <Button x:Name="DragButton" Content="Drag clip ↗" PreviewMouseLeftButtonDown="Drag_Down" PreviewMouseMove="Drag_Move" ToolTip="Drag this saved file into another app or folder." Padding="12,9" Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="PreviewSlot" Grid.Row="1" MinHeight="160">
      <Border x:Name="PreviewSurface" Focusable="True" Background="#050910" BorderBrush="#283A53" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Border.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Border.Resources>
        <Grid x:Name="VideoArea" Background="Transparent" MouseEnter="Video_Enter" MouseLeave="Video_Leave" MouseMove="Video_Move">
          <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" ScrubbingEnabled="True" MediaOpened="Player_Opened" MediaEnded="Player_Ended" MediaFailed="Player_Failed" MouseLeftButtonDown="Video_Click"/>
          <TextBlock x:Name="PlayerPlaceholder" Text="Loading your clip…" Foreground="#839DBE" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Border x:Name="PlaybackOverlay" Background="#E6142032" VerticalAlignment="Bottom" Padding="14,4" Margin="8" CornerRadius="8" Opacity="0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="PlayButton" Content="Play" Width="62" Click="Play_Click" Padding="8,7" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><TextBlock x:Name="PositionLabel" Text="0:00" FontFamily="Consolas" Foreground="#B6D4FF"/><TextBlock Text=" / " Foreground="#617C9E"/><TextBlock x:Name="DurationLabel" Text="0:00" Foreground="#93A9C8" FontFamily="Consolas"/></StackPanel>
              <local:TrimRange x:Name="Range" Grid.Column="2" RangeChanged="Range_Changed" SeekRequested="Range_Seek" ScrubStarted="Range_ScrubStarted" ScrubEnded="Range_ScrubEnded" AutomationProperties.Name="Playback and trim timeline"/>
              <ComboBox x:Name="PlaybackSpeed" Grid.Column="4" Width="82" SelectedIndex="3" SelectionChanged="Speed_Changed" AutomationProperties.Name="Playback speed" ToolTip="Playback speed" Margin="10,0" VerticalAlignment="Center"><ComboBoxItem Content=".25x"/><ComboBoxItem Content=".50x"/><ComboBoxItem Content=".75x"/><ComboBoxItem Content="1.00x"/><ComboBoxItem Content="1.25x"/><ComboBoxItem Content="1.50x"/><ComboBoxItem Content="1.75x"/><ComboBoxItem Content="2.0x"/></ComboBox>
              <Button x:Name="TrimButton" Grid.Column="3" Content="Save trim" Visibility="Hidden" Style="{StaticResource Primary}" Click="Trim_Click" Margin="10,0,0,0" Padding="10,7" VerticalAlignment="Center" ToolTip="Save the selected range and playback mix."/>
              <Button x:Name="FullscreenButton" Grid.Column="5" Content="&#xE740;" FontFamily="Segoe Fluent Icons" Click="Fullscreen_Click" AutomationProperties.Name="Fullscreen" ToolTip="Fullscreen · Esc to return" Padding="10,7" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="MixerCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,12">
      <StackPanel>
        <Grid Margin="0,0,0,8"><TextBlock Text="Audio Mixer" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="MixerHint" Text="Separate sources · saves automatically" Foreground="#7999C0" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><Grid Height="32"><TextBlock Text="Master Volume" FontSize="12" Margin="0,0,50,0" VerticalAlignment="Center" TextWrapping="Wrap"/><CheckBox x:Name="MasterEnabled" IsChecked="True" HorizontalAlignment="Right" Width="44" Checked="Master_Changed" Unchecked="Master_Changed" AutomationProperties.Name="Master audio enabled" ToolTip="All audio enabled"/></Grid><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.75" ValueChanged="Volume_Changed" AutomationProperties.Name="Preview master volume" ToolTip="Preview master volume" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="2"><Grid Height="32"><TextBlock x:Name="GameLabel" Text="Game" FontSize="12" Margin="0,0,50,0" VerticalAlignment="Center"/><CheckBox x:Name="GameEnabled" IsChecked="True" HorizontalAlignment="Right" Width="44" Checked="Mix_Changed" Unchecked="Mix_Changed" AutomationProperties.Name="Game audio enabled" ToolTip="Game audio enabled"/></Grid><Slider x:Name="GameVolume" Minimum="0" Maximum="2" Value="1" ValueChanged="MixVolume_Changed" AutomationProperties.Name="Game volume" Margin="0,5,0,0"/></StackPanel>
          <StackPanel x:Name="DiscordMixer" Grid.Column="4"><Grid Height="32"><TextBlock Text="Discord" FontSize="12" Margin="0,0,50,0" VerticalAlignment="Center"/><CheckBox x:Name="DiscordEnabled" IsChecked="True" HorizontalAlignment="Right" Width="44" Checked="Mix_Changed" Unchecked="Mix_Changed" AutomationProperties.Name="Discord audio enabled" ToolTip="Discord audio enabled"/></Grid><Slider x:Name="DiscordVolume" Minimum="0" Maximum="2" Value="1" ValueChanged="MixVolume_Changed" AutomationProperties.Name="Discord volume" Margin="0,5,0,0"/></StackPanel>
          <StackPanel x:Name="MicrophoneMixer" Grid.Column="6"><Grid Height="32"><TextBlock Text="Microphone" FontSize="12" Margin="0,0,50,0" VerticalAlignment="Center"/><CheckBox x:Name="MicrophoneEnabled" IsChecked="True" HorizontalAlignment="Right" Width="44" Checked="Mix_Changed" Unchecked="Mix_Changed" AutomationProperties.Name="Microphone audio enabled" ToolTip="Microphone audio enabled"/></Grid><Slider x:Name="MicrophoneVolume" Minimum="0" Maximum="2" Value="1" ValueChanged="MixVolume_Changed" AutomationProperties.Name="Microphone volume" Margin="0,5,0,0"/></StackPanel>
        </Grid>
        <TextBlock Text="Turn a source off to mute it; sliders start at original volume in the middle and can boost its level. Separate source tracks stay editable." Foreground="#718BAA" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>

      </StackPanel>
    </Border>
  </Grid>
</UserControl>

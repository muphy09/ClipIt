<Window x:Class="ClipIt.ClipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipIt"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClipIt 0.4" Width="1100" Height="940"
        WindowStartupLocation="CenterScreen" Background="#0B1019" Foreground="#EFF4FC"
        FontFamily="Segoe UI" FontSize="13" ResizeMode="CanResize" WindowStyle="None"
        Icon="Assets/ClipIt.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Style>
    <Style TargetType="Window">
      <Setter Property="MinWidth" Value="1000"/>
      <Setter Property="MinHeight" Value="740"/>
      <Style.Triggers>
        <Trigger Property="WindowState" Value="Maximized">
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="MinHeight" Value="0"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Style>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
      <ImageBrush x:Key="BrandMark" ImageSource="Assets/ClipIt-logo.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.183,0.117,0.610,0.517" Stretch="Uniform"/>
      <Style x:Key="CaptureSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style x:Key="CaptureStatusCard" TargetType="Border">
        <Setter Property="BorderBrush" Value="#29466E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Background">
          <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#162B47"/><GradientStop Offset="1" Color="#111B2B"/></LinearGradientBrush></Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="RecordingOption" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="ContentTemplate">
          <Setter.Value><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource FieldLabel}" Margin="0"/></DataTemplate></Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border BorderBrush="#28364B" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <!-- Custom title bar retains native drag, resize, snap and keyboard behavior. -->
      <Grid Background="#0D1420">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <Rectangle Width="20" Height="20" Fill="{StaticResource BrandMark}"/>
          <TextBlock Text="ClipIt" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock x:Name="HeaderVersion" Text=" /  INSTANT REPLAY" Foreground="#7890B0" FontSize="10" Margin="8,2,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource Quiet}" Width="44" Padding="0" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M 0 0 L 10 0" Stroke="#9CADC5" StrokeThickness="1"/></Button>
          <Button Style="{StaticResource Quiet}" Width="44" Padding="0" Click="Maximize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"><Rectangle Width="9" Height="9" Stroke="#9CADC5" StrokeThickness="1"/></Button>
          <Button Style="{StaticResource Quiet}" Width="44" Padding="0" Click="Hide_Click" ToolTip="Keep running in tray" AutomationProperties.Name="Close to tray"><Path Data="M 0 0 L 9 9 M 9 0 L 0 9" Stroke="#9CADC5" StrokeThickness="1.2"/></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#0E1521" BorderBrush="#1D293A" BorderThickness="0,0,1,0">
          <Grid Margin="18,26,18,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                <Rectangle Width="39" Height="36" Fill="{StaticResource BrandMark}"/>
                <TextBlock Text="ClipIt" FontSize="25" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="Finally something that works" TextWrapping="Wrap" FontSize="9" Foreground="#647995" Margin="8,15,0,30"/>
            </StackPanel>
            <StackPanel Grid.Row="1">
              <Button x:Name="CaptureNav" Style="{StaticResource LeftNavigation}" Background="#14294A" BorderBrush="#244876" Padding="14,12" Margin="0,0,0,8" Click="Capture_Click" AutomationProperties.Name="Capture settings">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" Foreground="#70A7FF" FontSize="16" Margin="0,0,11,0"/><TextBlock Text="Capture" Foreground="#A8CBFF" FontWeight="SemiBold"/></StackPanel>
              </Button>
              <Button x:Name="RecordingNav" Style="{StaticResource LeftNavigation}" HorizontalContentAlignment="Left" Click="Recording_Click" Padding="14,12" Margin="0,0,0,8" AutomationProperties.Name="Recording">
                <StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Stroke="#7B91AF" StrokeThickness="1.5" Margin="2,0,13,0"/><TextBlock Text="Recording" Foreground="#93A5BF"/></StackPanel>
              </Button>
              <Button x:Name="LibraryNav" Style="{StaticResource LeftNavigation}" HorizontalContentAlignment="Left" Click="Library_Click" Padding="14,12" Margin="0,0,0,8" AutomationProperties.Name="Your Clips">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="#7B91AF" FontSize="16" Margin="0,0,11,0"/><TextBlock Text="Your Clips" Foreground="#93A5BF"/></StackPanel>
              </Button>
              <Button x:Name="FavoritesNav" Style="{StaticResource LeftNavigation}" HorizontalContentAlignment="Left" Click="Favorites_Click" Padding="14,12" AutomationProperties.Name="Favorites">
                <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Stroke="#A9BDD9" StrokeThickness="1.35" StrokeLineJoin="Round" Margin="0,0,11,0" Data="M 8,1 L 10.2,5.5 15.2,6.2 11.6,9.7 12.4,14.7 8,12.3 3.6,14.7 4.4,9.7 0.8,6.2 5.8,5.5 Z"/><TextBlock Text="Favorites" Foreground="#93A5BF"/></StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Grid.Row="3">
              <Button x:Name="SettingsNav" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" Click="Settings_Click" Padding="14,12" Margin="0,0,0,16" AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="#7B91AF" FontSize="16" Margin="0,0,11,0"/><TextBlock Text="Settings" Foreground="#93A5BF"/></StackPanel>
              </Button>
              <Border Background="#111E30" BorderBrush="#24354C" BorderThickness="1" CornerRadius="9" Padding="13">
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><Ellipse x:Name="SideDot" Width="6" Height="6" Fill="#F2BC66" Margin="0,0,7,0"/><TextBlock x:Name="SideStatus" Text="Starting recorder" FontSize="11" Foreground="#BBCBE0"/></StackPanel>
                  <TextBlock x:Name="ReplayLengthLabel" Text="Replay Length: 2:00" Foreground="#647E9E" FontSize="10" Margin="13,7,0,0"/>
                </StackPanel>
              </Border>
              <WrapPanel Margin="8,3,0,0">
                <TextBlock x:Name="VersionLabel" Foreground="#7890B0" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="UpdateLabel" Text="- Checking for Updates…" Foreground="#7890B0" FontSize="10" MaxWidth="148" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button x:Name="CheckUpdateButton" Content="Check" Visibility="Collapsed" Style="{StaticResource Quiet}" Foreground="#9CC7FF" FontSize="10" Padding="5,3" Click="CheckUpdate_Click" AutomationProperties.Name="Check for updates"/>
                </StackPanel>
                <Button x:Name="UpdateButton" Visibility="Collapsed" Content="- Apply Update" Style="{StaticResource Quiet}" FontSize="10" Padding="4,6" HorizontalAlignment="Left" Click="Update_Click" AutomationProperties.Name="Update status" ToolTip="Updates download in the background and apply on demand or after a full quit and relaunch."/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="CapturePanel" Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
            <StackPanel Margin="30,24,25,24">
              <TextBlock Text="Capture" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,21"/>
              <Border Style="{StaticResource CaptureStatusCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9"><Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#F2BC66" Margin="0,0,8,0"/><TextBlock x:Name="LiveLabel" Text="GETTING READY" Foreground="#8AB6F6" FontSize="10" FontWeight="SemiBold"/></StackPanel>
                    <TextBlock x:Name="StatusTitle" Text="Replay buffer is building" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button x:Name="SaveClipButton" Style="{StaticResource Primary}" MinWidth="142" Click="SaveClip_Click" Padding="18,12" AutomationProperties.Name="Save clip"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="SaveButtonText" Text="Save clip" FontWeight="SemiBold" Foreground="White"/></StackPanel></Button>
                    <Button x:Name="PauseButton" Style="{StaticResource Quiet}" Content="Pause recording" Click="Pause_Click" Padding="8,8" Margin="0,5,0,0" FontSize="11"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="NoticeBorder" Background="#142942" BorderBrush="#2B4D76" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,14" Visibility="Collapsed"><TextBlock x:Name="NoticeText" Foreground="#B5D3FC" TextWrapping="Wrap" FontSize="12"/></Border>
              <Grid Margin="2,0,2,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/></Grid.RowDefinitions>
                <TextBlock x:Name="BufferDescription" Text="Replay buffer" FontSize="11" Foreground="#7F96B5" Margin="0,0,0,9"/>
                <TextBlock x:Name="BufferTime" Text="00:00 / 02:00" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#AEC5E5"/>
                <Border Grid.Row="1" Background="#1D2A3F" CornerRadius="2.5"/>
                <Border x:Name="BufferFill" Grid.Row="1" Background="#4D8DFF" CornerRadius="2.5" HorizontalAlignment="Left" Width="0"/>
              </Grid>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Margin="0,0,0,18"><TextBlock Text="Capture &amp; Quality" Style="{StaticResource CaptureSectionTitle}"/><TextBlock Text="HARDWARE ENCODED" FontSize="9" Foreground="#6289BC" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Display" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MonitorBox" AutomationProperties.Name="Capture display"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Resolution" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="QualityBox" AutomationProperties.Name="Resolution cap"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}p}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FpsBox" AutomationProperties.Name="Frame rate"/></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="Replay length" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ReplayLengthBox" AutomationProperties.Name="Replay length"/></StackPanel>
                  </Grid>
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Video bitrate" FontSize="12" Foreground="#BECBDD"/><TextBlock x:Name="EstimatedSizeLabel" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" ToolTip="Approximate size of a full replay, including all four audio tracks. Actual size varies with content and keyframe timing."/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="BitrateBox" Width="74" TextAlignment="Center" AutomationProperties.Name="Video bitrate in Mbps"/><TextBlock Text="Mbps" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#7188A8" FontSize="12"/></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border x:Name="QualityNotice" Style="{StaticResource InlineNotice}"><TextBlock x:Name="QualityNoticeText" TextWrapping="Wrap" Foreground="#F5CCA0" FontSize="12"/></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Save Location" Style="{StaticResource CaptureSectionTitle}" Margin="0,0,0,18"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Save folder" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FolderBox" AutomationProperties.Name="Save folder" ToolTip="Clips are saved in per-application subfolders here."/></StackPanel>
                    <Button Grid.Column="2" Content="Browse" Click="Browse_Click" VerticalAlignment="Bottom" Height="40" Padding="17,0"/>
                  </Grid>
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Capture shortcut" FontSize="12" Foreground="#BECBDD" VerticalAlignment="Center"/>
                    <TextBox x:Name="ShortcutBox" Grid.Column="1" IsReadOnly="True" TextAlignment="Center" FontWeight="SemiBold" Foreground="#A9CCFF" PreviewMouseLeftButtonDown="Shortcut_Click" PreviewKeyDown="Shortcut_KeyDown" GotKeyboardFocus="Shortcut_Focused" LostKeyboardFocus="Shortcut_Blurred" AutomationProperties.Name="Capture shortcut" ToolTip="Click and press a shortcut that includes Ctrl or Alt. Saves automatically."/>
                  </Grid>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Your Clips shortcut" FontSize="12" Foreground="#BECBDD" VerticalAlignment="Center"/>
                    <TextBox x:Name="LibraryShortcutBox" Grid.Column="1" IsReadOnly="True" TextAlignment="Center" FontWeight="SemiBold" Foreground="#A9CCFF" PreviewMouseLeftButtonDown="Shortcut_Click" PreviewKeyDown="Shortcut_KeyDown" GotKeyboardFocus="Shortcut_Focused" LostKeyboardFocus="Shortcut_Blurred" AutomationProperties.Name="Your Clips shortcut" ToolTip="Open Your Clips from anywhere, including when ClipIt is in the tray. Click and press Ctrl or Alt with a key. Saves automatically."/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border x:Name="LocationNotice" Style="{StaticResource InlineNotice}"><TextBlock x:Name="LocationNoticeText" TextWrapping="Wrap" Foreground="#F5CCA0" FontSize="12"/></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Application Selection" Style="{StaticResource CaptureSectionTitle}" Margin="0,0,0,14"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="GameAppBox" AutomationProperties.Name="Game audio application"/><Button Grid.Column="1" Content="Refresh apps" Style="{StaticResource Quiet}" Click="RefreshApps_Click" Margin="8,0,0,0"/></Grid>
                  <TextBlock x:Name="GameCaptureStatus" Text="Checking the application audio source…" Foreground="#95B9E9" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="Automatic mode follows a full-screen game and retains it while you alt-tab. Discord and microphone are separate tracks." Foreground="#879FBE" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
              <Border x:Name="ApplicationNotice" Style="{StaticResource InlineNotice}"><TextBlock x:Name="ApplicationNoticeText" TextWrapping="Wrap" Foreground="#F5CCA0" FontSize="12"/></Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,17"><TextBlock Text="Audio &amp; cursor" Style="{StaticResource CaptureSectionTitle}"/><TextBlock Text="SEPARATE AUDIO TRACKS" Foreground="#6289BC" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="MicToggle" AutomationProperties.Name="Include microphone"><StackPanel><TextBlock Text="Microphone" FontSize="12"/><TextBlock Text="Record the selected input" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel></CheckBox>
                    <CheckBox x:Name="CursorToggle" Grid.Column="2" AutomationProperties.Name="Include mouse cursor"><StackPanel><TextBlock Text="Mouse cursor" FontSize="12"/><TextBlock Text="Show the pointer in clips" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel></CheckBox>
                  </Grid>
                  <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="154"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="MicrophoneBox" AutomationProperties.Name="Microphone device" ToolTip="Select a specific microphone, or follow the system default."/>
                    <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="Boost Mic" FontSize="11"/>
                      <TextBlock Text="{Binding Value, ElementName=MicrophoneBoost, StringFormat={}{0:+0;0;0} dB}" FontSize="11" HorizontalAlignment="Right" Foreground="#9DB8DB"/>
                      <Slider x:Name="MicrophoneBoost" Grid.Row="1" Minimum="0" TickFrequency="1" SmallChange="1" LargeChange="3" IsSnapToTickEnabled="True" AutomationProperties.Name="Boost Mic in decibels" ToolTip="Increase the microphone level in new clips and recordings."/>
                    </Grid>
                    <Button x:Name="TestMicButton" Grid.Column="2" Content="Test Mic" Style="{StaticResource Quiet}" Click="TestMic_Click" Margin="12,0,0,0" FontSize="11"/>
                  </Grid>
                  <StackPanel x:Name="MicTestPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <ProgressBar x:Name="MicTestLevel" Minimum="-60" Maximum="0" Value="-60" Height="6" Foreground="#55D9AB" Background="#27364C" AutomationProperties.Name="Boosted microphone peak in dBFS"/>
                    <TextBlock x:Name="MicTestStatus" Foreground="#9DB8DB" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="AudioNotice" Style="{StaticResource InlineNotice}"><TextBlock x:Name="AudioNoticeText" TextWrapping="Wrap" Foreground="#F5CCA0" FontSize="12"/></Border>
              <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                      <TextBlock Text="Instant Replay overlay" Style="{StaticResource CaptureSectionTitle}"/>
                      <TextBlock Text="Shows replay status and flashes green when a clip is saved." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    <local:OverlayCornerPicker x:Name="CaptureOverlayCorner" Grid.Column="1" Margin="0,0,12,0" AutomationProperties.Name="Instant Replay overlay position"/>
                    <CheckBox x:Name="OverlayToggle" Grid.Column="2" Width="44" AutomationProperties.Name="Instant Replay overlay"/>
                  </Grid>
                  <TextBlock x:Name="CaptureOverlayError" Visibility="Collapsed" Foreground="#F5CCA0" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Grid Margin="2,18,2,0"><TextBlock x:Name="LastClipLabel" Text="Your Clips stay on your PC. Ready whenever you are." Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/></Grid>
            </StackPanel>
          </ScrollViewer>
          <Border x:Name="PendingSettingsBar" Visibility="Collapsed" Height="72" Grid.Row="1" Background="#101825" BorderBrush="#243147" BorderThickness="0,1,0,0" Padding="30,0">
            <Grid>
              <StackPanel VerticalAlignment="Center" Margin="0,0,160,0"><TextBlock x:Name="SettingsHint" Text="Changes have been made" Foreground="#C0CEE1" FontSize="12"/><TextBlock x:Name="SettingsSubtext" Text="Applying capture settings starts a fresh replay buffer." Foreground="#7E96B7" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
              <Button x:Name="ApplyButton" Content="Apply settings" Style="{StaticResource Primary}" Click="Apply_Click" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="138"/>
            </Grid>
          </Border>
        </Grid>
        <ScrollViewer x:Name="RecordingPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
          <StackPanel Margin="30,24,25,24">
            <TextBlock Text="Recording" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,21"/>
            <Border Style="{StaticResource CaptureStatusCard}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock x:Name="RecordingStatus" Text="Ready to record" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="RecordingStats" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="RecordingPause" Content="Pause" Click="RecordingPause_Click" Visibility="Collapsed" Margin="0,0,8,0" MinWidth="90"/>
                  <Button x:Name="RecordingAction" Content="Start Recording" Click="RecordingAction_Click" Style="{StaticResource Primary}" MinWidth="146" IsEnabled="False"/>
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel x:Name="RecordingConfiguration">
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Capture &amp; Quality" Style="{StaticResource CaptureSectionTitle}" Margin="0,0,0,18"/>
                  <CheckBox x:Name="RecordingUseCapture" Content="Use Capture quality settings" Style="{StaticResource RecordingOption}"/>
                  <StackPanel x:Name="RecordingQuality" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Display or window" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RecordingSource" AutomationProperties.Name="Recording source"/></StackPanel>
                      <Button Grid.Column="1" Content="Refresh" Style="{StaticResource Quiet}" Click="RefreshRecordingSources_Click" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                    </Grid>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                      <StackPanel Margin="0,0,10,0"><TextBlock Text="Resolution" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RecordingHeight" AutomationProperties.Name="Recording resolution"/></StackPanel>
                      <StackPanel><TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RecordingFps" AutomationProperties.Name="Recording frame rate"/></StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Audio &amp; cursor" Style="{StaticResource CaptureSectionTitle}" Margin="0,0,0,17"/>
                  <CheckBox x:Name="RecordingAudio" Content="Game or system audio" Style="{StaticResource RecordingOption}" Margin="0,0,0,10"/>
                  <ProgressBar x:Name="RecordingGameLevel" Height="5" Maximum="100" Foreground="#55D9AB" Background="#27364C" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.Name="Game or system audio level"/>
                  <CheckBox x:Name="RecordingMic" Content="Microphone" Style="{StaticResource RecordingOption}" Margin="0,0,0,10"/>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="154"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="RecordingMicDevice" AutomationProperties.Name="Recording microphone device"/>
                    <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="Boost Mic" FontSize="11"/>
                      <TextBlock Text="{Binding Value, ElementName=RecordingMicBoost, StringFormat={}{0:+0;0;0} dB}" FontSize="11" HorizontalAlignment="Right" Foreground="#9DB8DB"/>
                      <Slider x:Name="RecordingMicBoost" Grid.Row="1" Minimum="0" TickFrequency="1" SmallChange="1" LargeChange="3" IsSnapToTickEnabled="True" AutomationProperties.Name="Recording mic boost in decibels" ToolTip="Set microphone boost for future recordings. Uses the Capture value until adjusted."/>
                    </Grid>
                    <Button x:Name="RecordingTestMicButton" Grid.Column="2" Content="Test Mic" Style="{StaticResource Quiet}" Click="TestMic_Click" Margin="12,0,0,0" FontSize="11"/>
                  </Grid>
                  <StackPanel x:Name="RecordingMicTestPanel" Margin="0,0,0,12" Visibility="Collapsed">
                    <ProgressBar x:Name="RecordingMicTestLevel" Minimum="-60" Maximum="0" Value="-60" Height="6" Foreground="#55D9AB" Background="#27364C" AutomationProperties.Name="Boosted recording microphone peak in dBFS"/>
                    <TextBlock x:Name="RecordingMicTestStatus" Foreground="#9DB8DB" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ProgressBar x:Name="RecordingMicLevel" Height="5" Maximum="100" Foreground="#55D9AB" Background="#27364C" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.Name="Microphone level"/>
                  <CheckBox x:Name="RecordingCursor" Content="Record cursor" Style="{StaticResource RecordingOption}"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Controls &amp; Overlay" Style="{StaticResource CaptureSectionTitle}" Margin="0,0,0,18"/>
                <DockPanel Margin="0,0,0,12">
                  <TextBox x:Name="RecordingShortcutBox" DockPanel.Dock="Right" Width="230" IsReadOnly="True" TextAlignment="Center" FontWeight="SemiBold" Foreground="#A9CCFF" PreviewMouseLeftButtonDown="Shortcut_Click" PreviewKeyDown="Shortcut_KeyDown" GotKeyboardFocus="Shortcut_Focused" LostKeyboardFocus="Shortcut_Blurred" AutomationProperties.Name="Start or stop recording shortcut"/>
                  <TextBlock Text="Start / stop shortcut" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Recording indicator" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                  <local:OverlayCornerPicker x:Name="RecordingOverlayCorner" Grid.Column="1" Margin="0,0,12,0" AutomationProperties.Name="Recording overlay position"/>
                  <CheckBox x:Name="RecordingIndicator" Grid.Column="2" Width="44" AutomationProperties.Name="Recording indicator"/>
                </Grid>
                <Grid x:Name="RecordingTimeRow" Margin="20,4,0,16" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Show recording time" FontSize="13"/><TextBlock Text="Include the timer in the recording indicator." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><CheckBox x:Name="RecordingTime" Grid.Column="1" Width="44" AutomationProperties.Name="Show recording time"/></Grid>
                <CheckBox x:Name="RecordingSounds" Content="Start and stop sounds" Style="{StaticResource RecordingOption}" Margin="0,0,0,10"/>
                <CheckBox x:Name="RecordingTimed" Content="Timed Recording" Style="{StaticResource RecordingOption}"/>
                <StackPanel x:Name="RecordingDuration" Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBox x:Name="RecordingMinutes" Width="76" MaxLength="5" AutomationProperties.Name="Recording duration in minutes"/>
                  <TextBlock Text="minutes of recording" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Save Location" Style="{StaticResource CaptureSectionTitle}" Margin="0,0,0,18"/>
                <TextBlock x:Name="RecordingPath" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11"/>
                <TextBlock x:Name="RecordingDiskError" Foreground="#F89999" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="RecordingChangeFolder" Content="Change folder" Click="RecordingBrowse_Click"/>
                  <Button Content="Open folder" Click="RecordingOpenFolder_Click" Margin="8,0,0,0"/>
                  <Button x:Name="RecordingResetFolder" Content="Use default" Click="RecordingDefaultFolder_Click" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border x:Name="LibraryHost" Grid.Column="1" Visibility="Collapsed"/>
        <ScrollViewer x:Name="GeneralSettingsPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="30,24,30,24">
            <TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,24"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Portal Clips" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="Link another location with clips to be seen inside of the Your Clips area" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="PortalFolderBox" IsReadOnly="True" AutomationProperties.Name="Portal Clips folder"/>
                  <Button Grid.Column="1" Content="Browse" Click="BrowsePortal_Click" Margin="12,0,0,0" AutomationProperties.Name="Browse for Portal Clips folder"/>
                  <Button x:Name="ClearPortalButton" Grid.Column="2" Content="Clear" Click="ClearPortal_Click" Margin="8,0,0,0" AutomationProperties.Name="Clear Portal Clips folder"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Windows startup" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,20"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,24,0"><TextBlock Text="Start with Windows" FontSize="13"/><TextBlock x:Name="StartupHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                  <CheckBox x:Name="StartWindowsToggle" Grid.Column="1" Width="44" AutomationProperties.Name="Start with Windows"/>
                </Grid>
                <Grid x:Name="StartMinimizedRow" Margin="0,22,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,24,0"><TextBlock Text="Start minimized" FontSize="13"/><TextBlock Text="Keep ClipIt in the system tray when Windows starts." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                  <CheckBox x:Name="StartMinimizedToggle" Grid.Column="1" Width="44" AutomationProperties.Name="Start minimized"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Replay Buffer" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,24,0"><TextBlock Text="Save replay in RAM" FontSize="13"/><TextBlock Text="Buffer the replay in RAM instead of on disk." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                  <CheckBox x:Name="RamBufferToggle" Grid.Column="1" Width="44" AutomationProperties.Name="Save replay in RAM"/>
                </Grid>
                <TextBlock Text="Warning: Will increase RAM usage. Recommended only if the disk you are saving to is a HDD" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <Border x:Name="BufferDriveWarning" Visibility="Collapsed" Background="#30251E" CornerRadius="6" Padding="12" Margin="0,14,0,0"><TextBlock x:Name="BufferDriveWarningText" Foreground="#F5CCA0" TextWrapping="Wrap"/></Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0"><TextBlock Text="What's new" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="See the latest changes and fixes in ClipIt." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                <Button x:Name="PatchNotesButton" Grid.Column="1" Content="Patch Notes" Click="PatchNotes_Click" VerticalAlignment="Center" AutomationProperties.Name="Patch Notes"/>
              </Grid>
            </Border>
            <TextBlock x:Name="GeneralSettingsStatus" Text="Changes are saved automatically." Foreground="#95B9E9" TextWrapping="Wrap" Margin="2,18,2,0"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>

